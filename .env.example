# Metro UP — environment variables.
# Real values live ONLY in Railway. Never commit real secrets.
# Never expose these to the client (no NEXT_PUBLIC_ prefix on secrets).

# PostgreSQL connection string (provided by Railway Postgres plugin).
DATABASE_URL=

# Telegram bot token — server-only, used to verify Mini App initData.
TELEGRAM_BOT_TOKEN=

# Secret used to sign the session cookie (>= 16 chars, high entropy).
AUTH_SECRET=

# Public base URL of the deployed app (safe to expose).
NEXT_PUBLIC_APP_URL=

# Bot username (без @) for the SPM desktop Telegram Login Widget (public, safe).
# Also set the bot domain in BotFather (/setdomain) for the widget to work.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Dev-only: set to "1" to allow demo authentication. Never honoured in production.
ALLOW_DEMO_AUTH=

# Business timezone for the daily plan "today" rollover (default Europe/Moscow).
APP_TIMEZONE=

# ---------------------------------------------------------------------------
# Object storage (S3-compatible, e.g. Cloudflare R2) — SERVER-ONLY.
# Used for lesson video/image uploads. Binary is NEVER stored in Postgres.
# Do NOT prefix any of these with NEXT_PUBLIC_ (access key/secret must stay
# server-side). Real values live only in Railway Variables.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Metric AI (server-only; NEVER expose OPENAI_API_KEY to the client)
# ---------------------------------------------------------------------------
# Master switch. When "false", /metric shows a graceful "unavailable" state and
# no OpenAI request is ever made.
METRIC_AI_ENABLED=true
# OpenAI API key (required for chat + sync). Server-only.
OPENAI_API_KEY=
# Model used by the Responses API (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Max output tokens per answer (default 1200).
OPENAI_MAX_OUTPUT_TOKENS=1200
# The single METRO_UP knowledge vector store id. Create it once with
# `npm run metric:sync` (it prints the id), then set it here and re-run.
OPENAI_VECTOR_STORE_ID=
