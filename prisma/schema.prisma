// Metro UP — application data foundation.
// Production changes flow through migrations (never `prisma db push`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------ Enums ------------------------------

enum AppRole {
  EMPLOYEE
  CLUB_MANAGER
  SPM
  ADMIN
}

enum EmployeePosition {
  CLIENT_MANAGER
  NIGHT_MANAGER
  ADMINISTRATOR
}

enum CareerLevel {
  NEWCOMER
  MANAGER
  TOP_MANAGER
  LEADER
  MANAGER_PRO
}

enum AccessStatus {
  LIMITED
  PENDING_APPROVAL
  FULL
  SUSPENDED
}

// ------------------------------ Models -----------------------------

model User {
  id                String   @id @default(uuid()) @db.Uuid
  telegramId        String   @unique
  telegramUsername  String?
  telegramFirstName String?
  telegramLastName  String?
  telegramPhotoUrl  String?
  displayName       String
  role              AppRole  @default(EMPLOYEE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime?

  employeeProfile EmployeeProfile?
  lessonProgress  LessonProgress[]
  quizAttempts    QuizAttempt[]
  xpTransactions  XPTransaction[]
  dailyTasks      DailyTask[]
  mysteryResults  MysteryShopperResult[]
  monthlyRatings  MonthlyRating[]
  achievements    UserAchievement[]
  metricConversations MetricConversation[]

  @@index([telegramId])
  @@map("users")
}

model EmployeeProfile {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @unique @db.Uuid
  cityId              String
  clubId              String
  positionId          EmployeePosition
  careerLevel         CareerLevel      @default(NEWCOMER)
  accessStatus        AccessStatus     @default(LIMITED)
  onboardingCompleted Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id])
  club Club @relation(fields: [clubId], references: [id])

  @@index([cityId])
  @@index([clubId])
  @@map("employee_profiles")
}

model City {
  id        String   @id
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs            Club[]
  employeeProfiles EmployeeProfile[]

  @@map("cities")
}

model Club {
  id        String   @id
  cityId    String
  name      String
  address   String
  landmark  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city             City              @relation(fields: [cityId], references: [id], onDelete: Cascade)
  employeeProfiles EmployeeProfile[]
  taskTemplates    ClubTaskTemplate[]

  @@index([cityId])
  @@map("clubs")
}

// ----------------------- Content platform (LMS) --------------------
// Learning content authored in the ADMIN CMS and consumed by employees.
// New tables only — existing User/Profile/City/Club data is untouched.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlockType {
  VIDEO
  TEXT
  IMAGE
  INFO_CARD
  CHECKLIST
  SUMMARY
  COLLAPSIBLE_TEXT
  KEY_TAKEAWAYS
  EQUIPMENT_CARD
  GROUP_CLASS_CARD
}

enum MediaKind {
  VIDEO
  IMAGE
  DOCUMENT
}

enum MediaStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum XPReason {
  LESSON_COMPLETED
  QUIZ_COMPLETED
  PERFECT_QUIZ
  SPECIAL_EVENT
}

enum AuditAction {
  CREATE
  UPDATE
  PUBLISH
  UNPUBLISH
  ARCHIVE
  MEDIA_UPLOAD
}

model TrainingProgram {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdById String        @db.Uuid
  updatedById String        @db.Uuid

  days    TrainingDay[]
  courses Course[]

  @@index([status])
  @@map("training_programs")
}

model TrainingDay {
  id          String        @id @default(uuid()) @db.Uuid
  programId   String        @db.Uuid
  title       String
  description String?
  dayNumber   Int
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([programId, dayNumber])
  @@index([programId])
  @@map("training_days")
}

model Course {
  id               String        @id @default(uuid()) @db.Uuid
  programId        String        @db.Uuid
  trainingDayId    String?       @db.Uuid
  title            String
  shortDescription String?
  order            Int           @default(0)
  status           ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  program     TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  trainingDay TrainingDay?    @relation(fields: [trainingDayId], references: [id], onDelete: SetNull)
  lessons     Lesson[]

  @@index([programId])
  @@index([trainingDayId])
  @@map("courses")
}

model Lesson {
  id               String        @id @default(uuid()) @db.Uuid
  courseId         String        @db.Uuid
  title            String
  slug             String        @unique
  shortDescription String?
  durationMinutes  Int           @default(0)
  xpReward         Int           @default(0)
  isRequired       Boolean       @default(true)
  order            Int           @default(0)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  blocks   LessonBlock[]
  quiz     Quiz?
  progress LessonProgress[]

  @@index([courseId])
  @@index([status])
  @@map("lessons")
}

model LessonBlock {
  id        String    @id @default(uuid()) @db.Uuid
  lessonId  String    @db.Uuid
  type      BlockType
  order     Int       @default(0)
  data      Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_blocks")
}

model MediaAsset {
  id               String      @id @default(uuid()) @db.Uuid
  kind             MediaKind
  status           MediaStatus @default(UPLOADING)
  storageProvider  String
  storageKey       String      @unique
  mimeType         String
  sizeBytes        Int         @default(0)
  originalFilename String
  width            Int?
  height           Int?
  durationSeconds  Int?
  createdById      String      @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([kind])
  @@map("media_assets")
}

model Quiz {
  id             String        @id @default(uuid()) @db.Uuid
  lessonId       String        @unique @db.Uuid
  title          String
  description    String?
  passingPercent Int           @default(70)
  maxAttempts    Int?
  xpReward       Int           @default(0)
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id          String       @id @default(uuid()) @db.Uuid
  quizId      String       @db.Uuid
  text        String
  type        QuestionType
  order       Int          @default(0)
  explanation String?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model LessonProgress {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  lessonId    String         @db.Uuid
  status      ProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model QuizAttempt {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  quizId        String    @db.Uuid
  attemptNumber Int
  scorePercent  Int
  passed        Boolean
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  answers       Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId, attemptNumber])
  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model XPTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  reason     XPReason
  amount     Int
  sourceType String
  sourceId   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One XP grant per (user, reason, source) — makes completion idempotent.
  @@unique([userId, reason, sourceType, sourceId])
  @@index([userId])
  @@map("xp_transactions")
}

model ContentAuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String      @db.Uuid
  entityType  String
  entityId    String
  action      AuditAction
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("content_audit_logs")
}

// -------------------- Production Home / Rating foundation -----------------
// Daily plan, mystery shopper, monthly rating, and achievements. New tables
// only — existing users/profiles/content/progress/xp are untouched.

enum DailyTaskCategory {
  LEARNING
  SALES
  CLIENTS
  SERVICE
  SHIFT
  MANAGER
}

enum DailyTaskStatus {
  TODO
  COMPLETED
  SKIPPED
}

enum DailyTaskSource {
  SYSTEM
  ADMIN
  FUTURE_INTEGRATION
  MANAGER
}

enum DailyTaskPriority {
  NORMAL
  HIGH
}

enum MysteryStatus {
  DRAFT
  PUBLISHED
}

enum RatingStatus {
  DRAFT
  READY
  PUBLISHED
}

model DailyTaskTemplate {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique
  title        String
  description  String?
  category     DailyTaskCategory
  position     EmployeePosition?
  isActive     Boolean           @default(true)
  defaultOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("daily_task_templates")
}

model DailyTask {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @db.Uuid
  date               DateTime          @db.Date
  templateId         String?           @db.Uuid
  clubTaskTemplateId String?           @db.Uuid
  createdByUserId    String?           @db.Uuid
  title              String
  description        String?
  category           DailyTaskCategory
  status             DailyTaskStatus   @default(TODO)
  required           Boolean           @default(false)
  priority           DailyTaskPriority @default(NORMAL)
  timeHint           String?
  order              Int               @default(0)
  source             DailyTaskSource   @default(SYSTEM)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  completedAt        DateTime?

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubTaskTemplate ClubTaskTemplate?        @relation(fields: [clubTaskTemplateId], references: [id], onDelete: SetNull)
  checklistItems   DailyTaskChecklistItem[]

  // one row per (user, day, system-template) and per (user, day, club-template);
  // one-off manager tasks (both template ids NULL) are not constrained.
  @@unique([userId, date, templateId])
  @@unique([userId, date, clubTaskTemplateId])
  @@index([userId, date])
  @@map("daily_tasks")
}

model ClubTaskTemplate {
  id              String            @id @default(uuid()) @db.Uuid
  clubId          String
  code            String?
  title           String
  description     String?
  targetPosition  EmployeePosition?
  required        Boolean           @default(false)
  priority        DailyTaskPriority @default(NORMAL)
  timeHint        String?
  checklist       Json?
  defaultOrder    Int               @default(0)
  isActive        Boolean           @default(true)
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  club       Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  dailyTasks DailyTask[]

  // Stable code identifies a provisioned production default (null = manager-made).
  // Provisioning inserts a code only if absent — it never overwrites customizations.
  @@unique([clubId, code])
  @@index([clubId, isActive])
  @@map("club_task_templates")
}

model DailyTaskChecklistItem {
  id          String   @id @default(uuid()) @db.Uuid
  dailyTaskId String   @db.Uuid
  itemId      String
  text        String
  required    Boolean  @default(true)
  order       Int      @default(0)
  done        Boolean  @default(false)
  doneAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dailyTask DailyTask @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)

  // Snapshot per DailyTask; itemId is stable (copied from the template), never
  // the text. Unique makes checklist materialization idempotent.
  @@unique([dailyTaskId, itemId])
  @@index([dailyTaskId])
  @@map("daily_task_checklist_items")
}

model MysteryShopperResult {
  id              String        @id @default(uuid()) @db.Uuid
  employeeUserId  String        @db.Uuid
  periodMonth     Int
  periodYear      Int
  score           Int
  comment         String?
  status          MysteryStatus @default(DRAFT)
  checkedAt       DateTime?
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?

  employee User @relation(fields: [employeeUserId], references: [id], onDelete: Cascade)

  @@unique([employeeUserId, periodMonth, periodYear])
  @@index([employeeUserId, status])
  @@map("mystery_shopper_results")
}

model MonthlySalesInput {
  id             String   @id @default(uuid()) @db.Uuid
  employeeUserId String   @db.Uuid
  month          Int
  year           Int
  personalPlan   Int
  personalFact   Int
  salesScore     Float?
  enteredByUserId String  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeUserId, month, year])
  @@index([year, month])
  @@map("monthly_sales_inputs")
}

model MonthlyRating {
  id                  String       @id @default(uuid()) @db.Uuid
  employeeUserId      String       @db.Uuid
  month               Int
  year                Int
  salesScore          Float
  mysteryShopperScore Float
  finalScore          Float
  rank                Int
  previousRank        Int?
  status              RatingStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  employee User @relation(fields: [employeeUserId], references: [id], onDelete: Cascade)

  @@unique([employeeUserId, month, year])
  @@index([status, year, month])
  @@map("monthly_ratings")
}

model AchievementDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  title       String
  description String
  category    String
  icon        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAchievements UserAchievement[]

  @@map("achievement_definitions")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  awardedAt     DateTime @default(now())
  sourceType    String
  sourceId      String?

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// -------------------------- SPM rating workflow ---------------------------
// Period lifecycle, per-employee eligibility, and an audit trail for SPM
// actions. Reuses MonthlySalesInput / MysteryShopperResult / MonthlyRating.

enum RatingAuditAction {
  SALES_CREATE
  SALES_UPDATE
  MYSTERY_CREATE
  MYSTERY_UPDATE
  MYSTERY_PUBLISH
  ELIGIBILITY_CHANGE
  RATING_CALCULATE
  RATING_PUBLISH
  RATING_REOPEN
}

model RatingPeriod {
  id                String       @id @default(uuid()) @db.Uuid
  month             Int
  year              Int
  status            RatingStatus @default(DRAFT)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  calculatedAt      DateTime?
  publishedAt       DateTime?
  publishedByUserId String?      @db.Uuid

  @@unique([month, year])
  @@index([status])
  @@map("rating_periods")
}

model RatingEligibility {
  id              String   @id @default(uuid()) @db.Uuid
  employeeUserId  String   @db.Uuid
  month           Int
  year            Int
  isEligible      Boolean  @default(true)
  reason          String?
  updatedByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeUserId, month, year])
  @@index([month, year])
  @@map("rating_eligibility")
}

model RatingAuditLog {
  id          String            @id @default(uuid()) @db.Uuid
  actorUserId String            @db.Uuid
  action      RatingAuditAction
  entityType  String
  entityId    String
  month       Int?
  year        Int?
  before      Json?
  after       Json?
  createdAt   DateTime          @default(now())

  @@index([month, year])
  @@index([actorUserId])
  @@map("rating_audit_logs")
}

/* =========================================================================
 * Knowledge base — Scripts + Work Instructions (production CMS).
 * Independent knowledge objects (NOT linked to Lesson). Reuse ContentStatus
 * and the structured RichText document model. Employee API returns PUBLISHED
 * only. Additive — no existing table/column is modified.
 * ========================================================================= */

model ScriptCategory {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scripts Script[]

  @@map("script_categories")
}

model Script {
  id              String        @id @default(uuid()) @db.Uuid
  categoryId      String        @db.Uuid
  title           String
  slug            String        @unique
  description     String?
  /// Structured sections: whenToUse/goal/keyQuestions[]/script(RichDoc)/doNotSay[]/nextStep
  content         Json
  status          ContentStatus @default(DRAFT)
  order           Int           @default(0)
  createdByUserId String        @db.Uuid
  updatedByUserId String?       @db.Uuid
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category ScriptCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, status])
  @@index([status])
  @@map("scripts")
}

model WorkInstructionCategory {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instructions WorkInstruction[]

  @@map("work_instruction_categories")
}

model WorkInstruction {
  id              String        @id @default(uuid()) @db.Uuid
  categoryId      String        @db.Uuid
  title           String
  slug            String        @unique
  summary         String?
  /// Structured reference blocks: TEXT/STEPS/CHECKLIST/INFO_CARD/WARNING.
  /// CHECKLIST here is informational only — it never creates a DailyTask.
  blocks          Json
  status          ContentStatus @default(DRAFT)
  order           Int           @default(0)
  createdByUserId String        @db.Uuid
  updatedByUserId String?       @db.Uuid
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category WorkInstructionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, status])
  @@index([status])
  @@map("work_instructions")
}

/* Sensitive administrative changes (role / club / position) audit trail. */
model UserAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String   @db.Uuid
  targetUserId String   @db.Uuid
  action       String
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([actorUserId])
  @@map("user_audit_logs")
}

/* =========================================================================
 * Metric AI v1 — knowledge sync state + employee conversations.
 * Additive only. No secrets are stored (never the OpenAI key or raw errors).
 * ========================================================================= */

enum KnowledgeSourceType {
  ACADEMY
  SCRIPT
  INSTRUCTION
  DOCUMENT
}

enum KnowledgeSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum MetricMessageRole {
  USER
  ASSISTANT
}

/// Tracks the OpenAI vector-store sync state of one PUBLISHED knowledge source.
model KnowledgeSyncRecord {
  id                String              @id @default(uuid()) @db.Uuid
  sourceType        KnowledgeSourceType
  sourceId          String              @db.Uuid
  sourceUpdatedAt   DateTime
  status            KnowledgeSyncStatus @default(PENDING)
  /// "ALL" or a comma-separated EmployeePosition list — the access scope of the chunk.
  positionScope     String              @default("ALL")
  openaiFileId      String?
  vectorStoreFileId String?
  /// Short, non-sensitive failure reason (never a secret or full payload).
  lastErrorSafe     String?
  syncedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([sourceType, sourceId])
  @@index([status])
  @@map("knowledge_sync_records")
}

model MetricConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages MetricMessage[]

  @@index([userId, updatedAt])
  @@map("metric_conversations")
}

model MetricMessage {
  id               String            @id @default(uuid()) @db.Uuid
  conversationId   String            @db.Uuid
  role             MetricMessageRole
  content          String
  /// Structured source references shown as source cards (no secrets).
  sources          Json?
  openaiResponseId String?
  /// True when OpenAI reported the answer was cut off by the output-token limit.
  isTruncated      Boolean           @default(false)
  createdAt        DateTime          @default(now())

  conversation MetricConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("metric_messages")
}

/* Metric corporate documents — a fourth managed knowledge source (V1). */
enum MetricDocCategory {
  TRAINING_MANUAL
  CLUB_RULES
  WORK_REGULATION
  CONTRACT_TEMPLATE
  SALES_MATERIAL
  FINANCE_CASH
  REFUNDS
  HR
  OTHER
}

model MetricKnowledgeDocument {
  id               String            @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  category         MetricDocCategory @default(OTHER)
  status           ContentStatus     @default(DRAFT)
  originalFileName String
  mimeType         String
  fileSize         Int               @default(0)
  storageKey       String
  /// Extracted plain text (used for indexing + the employee viewer). No binary in DB.
  extractedText    String
  /// "ALL" or "SALES" — mirrors the knowledge access scope.
  positionScope    String            @default("ALL")
  versionLabel     String?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdByUserId  String            @db.Uuid
  updatedByUserId  String?           @db.Uuid
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([category])
  @@map("metric_knowledge_documents")
}
